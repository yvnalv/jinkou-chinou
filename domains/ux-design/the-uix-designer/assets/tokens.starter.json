          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.563,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 1.953,
          "unit": "rem"
        }
      },
      "3xl": {
        "$value": {
          "value": 2.441,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.5
      }
    }
  },
  "text": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}"
      }
    },
    "heading-1": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "normal": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "decelerate": {
        "$value": [
          0,
          0,
          0,
          1
        ]
      }
    }
  },
