  "size": {
    "$type": "dimension",
    "target-min": {
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "WCAG 2.2 SC 2.5.8 minimum pointer target"
    },
    "target-touch": {
      "$value": {
        "value": 44,
        "unit": "px"
      },
      "$description": "Comfortable touch target (Apple 44pt, Material 48dp)"
    },
    "content-max": {
      "$value": {
        "value": 72,
        "unit": "rem"
      }
    },
    "measure": {
      "$value": {
        "value": 40,
        "unit": "rem"
      },
      "$description": "Max width for running text (~65-75 characters)"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Placeholder: choose a typeface that fits the visual direction"
      },
      "display": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Placeholder: headings may use a more characterful face"
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
