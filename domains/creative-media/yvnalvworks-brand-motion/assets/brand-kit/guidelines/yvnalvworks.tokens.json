{
  "brand": "yvnalvworks",
  "owner": "Yovan Alvianto",
  "domain": "yvnalvworks.com",
  "handle": "@yvnalvworks",
  "colors": {
    "canvas": "#121212",
    "cardDark": "#18181b",
    "cardBorder": "#27272a",
    "cardLime": "#C1FF72",
    "textHeadline": "#FFFFFF",
    "textPureWhite": "#FFFFFF",
    "textSecondary": "#8E8E93",
    "textMuted": "#71717A",
    "accentLime": "#C1FF72",
    "danger": "#EF4444",
    "textIvory": "#F0ECE2"
  },
  "typography": {
    "primary": "Poppins, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "code": "'JetBrains Mono', 'Geist Mono', Consolas, monospace",
    "headlineWeight": 700,
    "subheadWeight": 600,
    "bodyWeight": 400,
    "headlineTracking": "-0.04em",
    "headlineLineHeight": 1.02,
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=block"
  },
  "iconography": {
    "system": "Lucide",
    "source": "https://lucide.dev",
    "strokeWidth": "2px",
    "strokeLinecap": "round",
    "strokeLinejoin": "round",
    "fill": "none",
    "viewBox": "0 0 24 24"
  },
  "dimensions": {
    "feed": {
      "aspectRatio": "4:5",
      "width": 1080,
      "height": 1350,
      "padding": 80
    },
    "reels": {
      "aspectRatio": "9:16",
      "width": 1080,
      "height": 1920,
      "safeTop": 150,
      "safeBottom": 280,
      "ccLockedY": 1480,
      "centerX": 540,
      "contentLeft": 120,
      "contentRight": 960,
      "lockup": {
        "x": 60,
        "y": 168,
        "avatar": 54
      },
      "captions": {
        "centerY": 1480,
        "font": "Poppins 600 46px",
        "color": "#FFFFFF",
        "pill": "rgba(18,18,18,0.78) with 1px #27272a border",
        "case": "sentence",
        "wordsPerCue": "3-6",
        "maxChars": 32
      },
      "spec": "references/reels-motion-system.md",
      "starter": "assets/reel-starter/"
    }
  },
  "background": {
    "image": "assets/brand-kit/backgrounds/yvnalvworks-grain-bg.png",
    "size": "cover",
    "fallbackColor": "#121212",
    "rule": "Always use the grain image; never a flat fill"
  },
  "cover": {
    "spec": "references/cover-slide-spec.md",
    "blockMaxWidth": 860,
    "blockOffsetX": -20,
    "blockOffsetY": -55,
    "avatar": {
      "file": "assets/brand-kit/logos/yovan-avatar-color.png",
      "size": 66,
      "gapToText": 10
    },
    "name": {
      "text": "yvnalvworks",
      "weight": 600,
      "size": 24,
      "color": "#FFFFFF"
    },
    "handle": {
      "text": "@yvnalvworks",
      "weight": 400,
      "size": 21,
      "color": "#F0ECE2"
    },
    "lockupToHeadlineGap": 46,
    "headline": {
      "weight": 700,
      "size": 96,
      "lineHeight": 1.02,
      "tracking": "-0.04em",
      "color": "#FFFFFF",
      "highlightColor": "#C1FF72",
      "lines": "3-4",
      "highlightPhrases": 1
    }
  },
  "motionColors": {
    "good": "#C1FF72",
    "failure": "#EF4444",
    "neutral": "#F0ECE2",
    "pending": "#71717A"
  }
}
