[
  {"id": 1, "start": 0.0, "end": 2.14, "text": "Your ninety-eight percent model missed"},
  {"id": 2, "start": 2.14, "end": 3.43, "text": "half the defects"},
  {"id": 3, "start": 3.73, "end": 6.3, "text": "In the lab it looked perfect,"},
  {"id": 4, "start": 6.3, "end": 9.73, "text": "so you shipped it to the factory camera,"},
  {"id": 5, "start": 9.73, "end": 12.73, "text": "and a week later the defect reports"},
  {"id": 6, "start": 12.73, "end": 14.44, "text": "started piling up again"},
  {"id": 7, "start": 14.74, "end": 18.17, "text": "The lab photos were clean and evenly lit,"},
  {"id": 8, "start": 18.17, "end": 21.6, "text": "but the factory has glare from the windows,"},
  {"id": 9, "start": 21.6, "end": 24.6, "text": "dust on the lens, and a camera"},
  {"id": 10, "start": 24.6, "end": 26.31, "text": "that shakes a little"},
  {"id": 11, "start": 26.31, "end": 28.46, "text": "every time the belt moves"},
  {"id": 12, "start": 28.76, "end": 30.9, "text": "So before you swap architectures,"},
  {"id": 13, "start": 30.9, "end": 33.04, "text": "collect a few hundred frames"},
  {"id": 14, "start": 33.04, "end": 36.9, "text": "from that real camera and test on those first,"},
  {"id": 15, "start": 36.9, "end": 38.61, "text": "because that's where your"},
  {"id": 16, "start": 38.61, "end": 39.9, "text": "accuracy actually lives"},
  {"id": 17, "start": 40.2, "end": 41.49, "text": "Follow for more"}
]
