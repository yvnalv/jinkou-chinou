[
  {"id": 1, "start": 0.0, "end": 1.29, "text": "Your model scores"},
  {"id": 2, "start": 1.29, "end": 3.43, "text": "ninety-eight percent in the lab"},
  {"id": 3, "start": 3.43, "end": 5.14, "text": "so you ship it"},
  {"id": 4, "start": 5.14, "end": 6.86, "text": "to the factory camera"},
  {"id": 5, "start": 7.16, "end": 9.3, "text": "A week later, it's missing"},
  {"id": 6, "start": 9.3, "end": 10.59, "text": "half the defects"},
  {"id": 7, "start": 10.89, "end": 12.17, "text": "Here's what changed"},
  {"id": 8, "start": 12.47, "end": 14.61, "text": "The lab photos were clean"},
  {"id": 9, "start": 14.61, "end": 16.76, "text": "but the factory has glare"},
  {"id": 10, "start": 16.76, "end": 18.47, "text": "dust, and a camera"},
  {"id": 11, "start": 18.47, "end": 20.19, "text": "that shakes a little"},
  {"id": 12, "start": 20.19, "end": 22.33, "text": "every time the belt moves"},
  {"id": 13, "start": 22.63, "end": 24.77, "text": "So before you swap architectures"},
  {"id": 14, "start": 24.77, "end": 26.91, "text": "collect a few hundred frames"},
  {"id": 15, "start": 26.91, "end": 28.63, "text": "from the real camera"},
  {"id": 16, "start": 28.63, "end": 30.77, "text": "and test on those first"},
  {"id": 17, "start": 31.07, "end": 32.36, "text": "Follow for more"}
]
