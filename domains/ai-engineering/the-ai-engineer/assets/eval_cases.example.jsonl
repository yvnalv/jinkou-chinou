{"id": "refund-window", "input": "How long do I have to return an unopened item?", "expected": "30 days", "tags": ["policy"], "graders": [{"type": "contains", "value": "30 days"}, {"type": "max_length", "value": 600}]}
{"id": "refund-no-invention", "input": "Can I return a gift card?", "expected": "Gift cards cannot be returned.", "tags": ["policy", "must-pass"], "graders": [{"type": "regex", "pattern": "(cannot|can't|not) be returned|non-returnable"}, {"type": "not_contains", "values": ["store credit guaranteed"]}]}
