# ==============================================================================
# UI/UX Test Suite Environment Variables Template
# Copy this file to `.env.test` or `.env.local` and fill in your test credentials.
# IMPORTANT: Ensure `.env*` is in your `.gitignore` so secrets are never committed!
# ==============================================================================

# Application Target URL
BASE_URL=http://localhost:3000

# Automated Test Account Credentials
TEST_USER_EMAIL=qa-testuser@example.com
TEST_USER_PASSWORD=ChangeMeWithSecureTestPassword123!

# Optional Secondary Role (e.g. Admin / Supervisor)
ADMIN_USER_EMAIL=qa-admin@example.com
ADMIN_USER_PASSWORD=ChangeMeWithAdminPassword123!

# Headless / Debug Mode
CI=false
HEADLESS=true
